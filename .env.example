# Copy this file to .env and fill in real keys. .env is gitignored; this file is not.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://app.tavily.com/home
TAVILY_API_KEY=

# Path to the run config. Defaults to ./config.yaml if unset.
DIGEST_CONFIG=

# Path to the SQLite DB file. Defaults to digest.db next to db.py if unset.
DIGEST_DB=

# DB sync backend: local (default, no-op) | s3 | gcs (both unimplemented stubs)
DIGEST_STORAGE=

# Digest delivery backend: local (default: print + files under digests/) | email | webhook (both unimplemented stubs)
DIGEST_DELIVERY=
